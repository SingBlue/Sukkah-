<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#17241a">
<title>Sukkah Measure</title>
<style>
:root{
  --ink:#17241a; --leaf:#5f8a3c; --leaf-soft:#dfe9cf; --bg:#f1f4ea;
  --wood:#9a6532; --line:#c6d1b4; --bad:#a63d2f; --ok:#3f7a2a;
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font:16px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;padding-bottom:48px}
.wrap{max-width:560px;margin:0 auto;padding:20px 18px}
header{display:flex;align-items:baseline;gap:14px;border-bottom:3px solid var(--wood);padding-bottom:10px;margin-bottom:18px}
header .he{font:700 60px/1 "Noto Serif Hebrew","Frank Ruhl Libre","Times New Roman",serif;color:var(--ink)}
header .en{font-size:15px;color:#4c5d4a}
h2{font-size:17px;margin:26px 0 8px}
.card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:14px}
button{font:inherit;cursor:pointer}
.btn{background:var(--ink);color:#fff;border:0;border-radius:8px;padding:13px 16px;font-weight:600;width:100%}
.btn:disabled{background:#9aa596;cursor:not-allowed}
.btn.alt{background:#fff;color:var(--ink);border:2px solid var(--ink)}
.status{font-size:14px;color:#4c5d4a;margin:8px 0 0}
.seg{display:inline-flex;border:2px solid var(--ink);border-radius:8px;overflow:hidden}
.seg button{background:#fff;border:0;padding:6px 16px;font-weight:600}
.seg button.on{background:var(--ink);color:#fff}
.row{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.fields{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
label{display:block;font-size:14px;font-weight:600;margin-bottom:4px}
input[type=number]{width:100%;font:inherit;font-size:20px;padding:10px 8px;border:2px solid var(--line);border-radius:8px;background:#fff;color:var(--ink)}
input[type=number]:focus{outline:3px solid var(--leaf);border-color:var(--leaf)}
.dim{border-top:1px solid var(--line);padding:10px 0}
.dim:first-child{border-top:0;padding-top:0}
.dim h3{margin:0 0 4px;font-size:16px;display:flex;justify-content:space-between}
.dim h3 span{font-weight:400;color:#4c5d4a;font-size:14px}
.op{display:flex;justify-content:space-between;font-size:15px;padding:2px 0}
.ok{color:var(--ok);font-weight:700}
.no{color:var(--bad);font-weight:700}
.verdict{border-left:6px solid var(--leaf);background:var(--leaf-soft);padding:12px;border-radius:0 8px 8px 0;margin-top:12px}
.verdict.warn{border-color:var(--wood);background:#f3e6d6}
.verdict.bad{border-color:var(--bad);background:#f4dcd8}
.small{font-size:13px;color:#4c5d4a}
svg{width:100%;height:auto;display:block}
.orow{border-top:1px solid var(--line);padding:10px 0}
.orow:first-child{border-top:0;padding-top:0}
.otop{display:flex;gap:8px;align-items:center}
input.oname{flex:1 1 40%;min-width:0;width:auto;font-size:17px;padding:10px 8px;border:2px solid var(--line);border-radius:8px;background:#fff;color:var(--ink);font-family:inherit}
input.oval{flex:0 0 100px;width:100px;font-size:17px;padding:10px 8px}
input.oname:focus{outline:3px solid var(--leaf);border-color:var(--leaf)}
.odel{flex:0 0 auto;border:2px solid var(--line);background:#fff;color:var(--bad);border-radius:8px;width:42px;height:44px;font-size:18px}
.conv{margin-top:4px}
.btnrow{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}
.btnrow .btn{flex:1 1 auto;width:auto}

/* AR overlay */
#glcanvas{position:fixed;left:0;top:0;width:100%;height:100%;display:none;z-index:0}
body.ar #glcanvas{display:block}
#arui{position:fixed;inset:0;opacity:0;pointer-events:none;z-index:5;display:flex;flex-direction:column;justify-content:space-between;color:#fff}
body.ar #arui{opacity:1}
body.ar #arui>*{pointer-events:auto}
#artop{padding:12px;background:linear-gradient(#000a,#0000)}
#chips{display:flex;gap:8px;margin-bottom:8px}
#chips button{flex:1;border:2px solid #fff;background:#0006;color:#fff;border-radius:20px;padding:6px 0;font-weight:600}
#chips button.on{background:#fff;color:var(--ink)}
#prompt{font-size:15px}
#dist{font:700 34px/1.1 system-ui,sans-serif;text-shadow:0 1px 4px #000}
#arbottom{padding:14px;background:linear-gradient(#0000,#000a);display:flex;gap:8px;flex-wrap:wrap}
#arbottom button{flex:1 1 40%;border:0;border-radius:8px;padding:14px;font-weight:700;background:#fff;color:var(--ink)}
#arbottom #place,#arbottom #save{background:#ffe066}
#arbottom .hide{display:none}
</style>
</head>
<body>
<div class="wrap">
  <header><div class="he">סוכה</div><div class="en">Sukkah measure</div></header>

  <div class="card">
    <button class="btn" id="startAR" disabled>Measure with camera</button>
    <p class="status" id="arStatus">Checking camera measuring support…</p>
    <p class="small">Point at one inside corner, tap, then the opposite corner. It saves the distance into the fields below. Choose <b>Other</b> in the camera view to measure anything else, like a door.</p>
  </div>

  <h2>Inside dimensions</h2>
  <div class="card">
    <div class="row">
      <span class="small">Measure wall to wall, and floor to the underside of the s’chach.</span>
      <div class="seg" id="unitSeg"><button data-u="cm" class="on">cm</button><button data-u="in">in</button></div>
    </div>
    <div class="fields">
      <div><label for="in_length">Length</label><input id="in_length" type="number" inputmode="decimal" step="any" min="0"></div>
      <div><label for="in_width">Width</label><input id="in_width" type="number" inputmode="decimal" step="any" min="0"></div>
      <div><label for="in_height">Height</label><input id="in_height" type="number" inputmode="decimal" step="any" min="0"></div>
    </div>
    <button class="btn alt" id="clearDims" style="margin-top:12px">Clear sukkah measurements</button>
  </div>

  <h2>Results</h2>
  <div class="card" id="results"><p class="small" style="margin:0">Enter or measure the length, width and height.</p></div>

  <h2>Floor plan</h2>
  <div class="card">
    <svg id="plan" viewBox="0 0 220 200" role="img" aria-label="Sukkah floor plan compared with minimum size"></svg>
    <p class="small" style="margin:6px 0 0">Green is your sukkah. Dashed squares are the 7×7 tefachim minimum for each opinion.</p>
  </div>

  <h2>Other measurements</h2>
  <div class="card">
    <div id="others"></div>
    <div class="btnrow">
      <button class="btn alt" id="addOther">+ Add measurement</button>
      <button class="btn alt" id="copyOthers">Copy list</button>
      <button class="btn alt" id="clearOthers">Clear all</button>
    </div>
  </div>

  <p class="small" style="margin-top:20px">Shiurim differ by custom (this uses a tefach of 8.0 cm for Rabbi Chaim Naeh and 9.6 cm for the Chazon Ish). Camera measurements can drift a little, so confirm anything close with a tape measure and ask your rabbi.</p>
</div>

<!-- AR overlay -->
<div id="arui">
  <div id="artop">
    <div id="chips">
      <button data-k="length">Length</button>
      <button data-k="width">Width</button>
      <button data-k="height">Height</button>
      <button data-k="other">Other</button>
    </div>
    <div id="dist">—</div>
    <div id="prompt"></div>
  </div>
  <div id="arbottom">
    <button id="place">Place point</button>
    <button id="save" class="hide">Save</button>
    <button id="undo" class="hide">Redo</button>
    <button id="exit">Done</button>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const $ = id => document.getElementById(id);
const OPINIONS = [{n:"Rabbi Chaim Naeh", t:8.0},{n:"Chazon Ish", t:9.6}];
const KEYS = ["length","width","height"];
const LABEL = {length:"Length",width:"Width",height:"Height",other:"Other"};
const S = {unit:"cm", dims:{length:null,width:null,height:null}, others:[]};

try{ const saved = JSON.parse(localStorage.getItem("sukkah")||"null"); if(saved){ S.unit=saved.unit||"cm"; Object.assign(S.dims,saved.dims||{}); S.others = Array.isArray(saved.others) ? saved.others : []; } }catch(e){}
function persist(){ try{ localStorage.setItem("sukkah", JSON.stringify(S)); }catch(e){} }

const toUnit = cm => S.unit==="cm" ? cm : cm/2.54;
const fromUnit = v => S.unit==="cm" ? v : v*2.54;
const fmt = (n,d=1) => n.toFixed(d).replace(/\.0+$/,"");

function renderFields(){
  KEYS.forEach(k=>{
    const v = S.dims[k];
    $("in_"+k).value = v==null ? "" : fmt(toUnit(v), S.unit==="cm"?0:1);
  });
  document.querySelectorAll("#unitSeg button").forEach(b=>b.classList.toggle("on", b.dataset.u===S.unit));
  renderOthers();
}

function evalDim(k, cm){
  return OPINIONS.map(o=>{
    const tf = cm/o.t; let ok, note="";
    if(k==="height"){
      ok = tf>=10 && tf<=120;
      if(tf<10) note = fmt(10*o.t-cm,0)+" cm too low";
      else if(tf>120) note = "over 20 amot";
    } else {
      ok = tf>=7;
      if(!ok) note = fmt(7*o.t-cm,0)+" cm short";
    }
    return {o,tf,ok,note};
  });
}

function renderResults(){
  const box = $("results");
  const have = KEYS.filter(k=>S.dims[k]>0);
  if(!have.length){ box.innerHTML='<p class="small" style="margin:0">Enter or measure the length, width and height.</p>'; drawPlan(); return; }
  let html = "";
  const pass = OPINIONS.map(()=>true);
  KEYS.forEach(k=>{
    const cm = S.dims[k];
    if(!(cm>0)){ OPINIONS.forEach((_,i)=>pass[i]=false); return; }
    const ev = evalDim(k,cm);
    ev.forEach((e,i)=>{ if(!e.ok) pass[i]=false; });
    html += `<div class="dim"><h3>${LABEL[k]}<span>${fmt(cm,0)} cm · ${fmt(cm/2.54,1)} in</span></h3>` +
      ev.map(e=>`<div class="op"><span>${e.o.n}: ${fmt(e.tf,1)} tefachim</span><span class="${e.ok?"ok":"no"}">${e.ok?"Meets":e.note||"No"}</span></div>`).join("") + `</div>`;
  });
  if(have.length===3){
    let cls="verdict", msg;
    if(pass[0]&&pass[1]) msg="Meets the size requirements by both opinions.";
    else if(pass[0]) { cls+=" warn"; msg="Meets the requirements by Rabbi Chaim Naeh’s shiur but not the Chazon Ish’s. Ask your rabbi which to follow."; }
    else if(pass[1]) { cls+=" warn"; msg="Meets the requirements by the Chazon Ish’s shiur but not Rabbi Chaim Naeh’s. Ask your rabbi."; }
    else { cls+=" bad"; msg="Does not meet the minimum size by either opinion. See the shortfalls above."; }
    html += `<div class="${cls}">${msg}</div>`;
  }
  box.innerHTML = html;
  drawPlan();
}

function drawPlan(){
  const L=S.dims.length, W=S.dims.width, svg=$("plan");
  const mins = OPINIONS.map(o=>7*o.t);
  const maxDim = Math.max(L||0, W||0, mins[1]);
  const sc = 160/maxDim, ox=30, oy=20;
  let s = "";
  if(L>0 && W>0){
    const w=L*sc, h=W*sc;
    s += `<rect x="${ox}" y="${oy}" width="${w}" height="${h}" fill="#dfe9cf" stroke="#5f8a3c" stroke-width="2"/>`;
    s += `<text x="${ox+w/2}" y="${oy+h+16}" text-anchor="middle" font-size="11" fill="#17241a">${fmt(L,0)} cm</text>`;
    s += `<text x="${ox-6}" y="${oy+h/2}" text-anchor="middle" font-size="11" fill="#17241a" transform="rotate(-90 ${ox-6} ${oy+h/2})">${fmt(W,0)} cm</text>`;
  }
  mins.forEach((m,i)=>{
    const d=m*sc;
    s += `<rect x="${ox}" y="${oy}" width="${d}" height="${d}" fill="none" stroke="${i?"#a63d2f":"#9a6532"}" stroke-width="1.5" stroke-dasharray="5 4"/>`;
  });
  s += `<text x="${ox+mins[0]*sc+4}" y="${oy+12}" font-size="10" fill="#9a6532">Naeh</text>`;
  s += `<text x="${ox+mins[1]*sc+4}" y="${oy+mins[1]*sc-3}" font-size="10" fill="#a63d2f">Chazon Ish</text>`;
  svg.innerHTML = s;
}

/* ---------- Other measurements ---------- */
function newId(){ return Date.now().toString(36)+Math.random().toString(36).slice(2,6); }
function escAttr(t){ return String(t||"").replace(/&/g,"&amp;").replace(/"/g,"&quot;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }
function convText(cm){
  if(!(cm>0)) return "";
  return `${fmt(cm,1)} cm · ${fmt(cm/2.54,1)} in · ${fmt(cm/OPINIONS[0].t,1)} / ${fmt(cm/OPINIONS[1].t,1)} tefachim`;
}
function renderOthers(){
  const box = $("others");
  if(!S.others.length){
    box.innerHTML = '<p class="small" style="margin:0">Nothing yet. Tap “Add measurement” to type one in, or choose Other in the camera view.</p>';
    return;
  }
  box.innerHTML = S.others.map(o=>`
    <div class="orow" data-id="${o.id}">
      <div class="otop">
        <input class="oname" type="text" placeholder="Name (e.g. Door)" value="${escAttr(o.name)}" aria-label="Name">
        <input class="oval" type="number" inputmode="decimal" step="any" min="0" placeholder="${S.unit}" value="${o.cm>0 ? fmt(toUnit(o.cm),1) : ""}" aria-label="Measurement in ${S.unit}">
        <button class="odel" aria-label="Delete">✕</button>
      </div>
      <div class="conv small">${convText(o.cm)}</div>
    </div>`).join("");
}
$("others").addEventListener("input", e=>{
  const row = e.target.closest(".orow"); if(!row) return;
  const o = S.others.find(x=>x.id===row.dataset.id); if(!o) return;
  if(e.target.classList.contains("oname")) o.name = e.target.value;
  if(e.target.classList.contains("oval")){
    const v = parseFloat(e.target.value);
    o.cm = v>0 ? fromUnit(v) : null;
    row.querySelector(".conv").textContent = convText(o.cm);
  }
  persist();
});
$("others").addEventListener("click", e=>{
  const b = e.target.closest(".odel"); if(!b) return;
  const row = b.closest(".orow");
  const o = S.others.find(x=>x.id===row.dataset.id);
  if(!confirm("Delete " + (o && o.name ? o.name : "this measurement") + "?")) return;
  S.others = S.others.filter(x=>x.id!==row.dataset.id);
  persist(); renderOthers();
});
$("addOther").addEventListener("click", ()=>{
  S.others.push({id:newId(), name:"", cm:null});
  persist(); renderOthers();
  const last = $("others").querySelector(".orow:last-child .oname");
  if(last) last.focus();
});
$("copyOthers").addEventListener("click", async ()=>{
  const lines = S.others.filter(o=>o.cm>0).map(o=>`${o.name||"Unnamed"}: ${fmt(o.cm,1)} cm (${fmt(o.cm/2.54,1)} in)`);
  if(!lines.length) return;
  const b = $("copyOthers");
  try{ await navigator.clipboard.writeText(lines.join("\n")); b.textContent = "Copied ✓"; setTimeout(()=>{ b.textContent = "Copy list"; }, 1500); }catch(err){}
});

$("clearDims").addEventListener("click", ()=>{
  if(!confirm("Clear length, width and height?")) return;
  S.dims = {length:null,width:null,height:null};
  persist(); renderFields(); renderResults();
});
$("clearOthers").addEventListener("click", ()=>{
  if(!S.others.length) return;
  if(!confirm("Delete all other measurements?")) return;
  S.others = [];
  persist(); renderOthers();
});

/* Inputs */
KEYS.forEach(k=>{
  $("in_"+k).addEventListener("input", e=>{
    const v = parseFloat(e.target.value);
    S.dims[k] = v>0 ? fromUnit(v) : null;
    persist(); renderResults();
  });
});
document.querySelectorAll("#unitSeg button").forEach(b=>b.addEventListener("click",()=>{
  S.unit=b.dataset.u; persist(); renderFields();
}));

/* ---------- AR measuring (WebXR + three.js) ---------- */
let renderer, scene, camera, reticle, line, session=null, hitSource=null;
let pts=[], markers=[], current="length", lastDistText="";

function initThree(){
  scene = new THREE.Scene();
  camera = new THREE.PerspectiveCamera(70, innerWidth/innerHeight, 0.01, 20);
  renderer = new THREE.WebGLRenderer({antialias:true, alpha:true});
  renderer.setPixelRatio(devicePixelRatio);
  renderer.setSize(innerWidth, innerHeight);
  renderer.xr.enabled = true;
  renderer.domElement.id = "glcanvas";
  document.body.appendChild(renderer.domElement);
  reticle = new THREE.Mesh(
    new THREE.RingGeometry(0.03,0.045,32).rotateX(-Math.PI/2),
    new THREE.MeshBasicMaterial({color:0xffffff}));
  reticle.matrixAutoUpdate = false; reticle.visible = false; scene.add(reticle);
  const g = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(),new THREE.Vector3()]);
  line = new THREE.Line(g, new THREE.LineBasicMaterial({color:0xffe066}));
  line.frustumCulled = false; line.visible = false; scene.add(line);
  renderer.setAnimationLoop(onFrame);
}

function reticlePos(){ return new THREE.Vector3().setFromMatrixPosition(reticle.matrix); }

function onFrame(_, frame){
  if(frame && hitSource){
    const ref = renderer.xr.getReferenceSpace();
    const hits = frame.getHitTestResults(hitSource);
    if(hits.length){
      const pose = hits[0].getPose(ref);
      reticle.visible = true;
      reticle.matrix.fromArray(pose.transform.matrix);
    } else reticle.visible = false;

    if(pts.length===1 && reticle.visible){
      setLine(pts[0], reticlePos());
      showDist(pts[0].distanceTo(reticlePos()));
    }
  }
  renderer.render(scene, camera);
}

function setLine(a,b){
  const p = line.geometry.attributes.position;
  p.setXYZ(0,a.x,a.y,a.z); p.setXYZ(1,b.x,b.y,b.z); p.needsUpdate = true;
  line.visible = true;
}
function showDist(m){
  const cm = m*100;
  const t = `${fmt(cm,0)} cm · ${fmt(cm/2.54,1)} in`;
  if(t!==lastDistText){ $("dist").textContent = t; lastDistText = t; }
}

function addMarker(v){
  const m = new THREE.Mesh(new THREE.SphereGeometry(0.014,16,16), new THREE.MeshBasicMaterial({color:0xffe066}));
  m.position.copy(v); scene.add(m); markers.push(m);
}
function clearPoints(){
  pts=[]; markers.forEach(m=>scene.remove(m)); markers=[];
  if(line) line.visible=false;
  lastDistText=""; $("dist").textContent="—";
}

function uiState(){
  const n = pts.length;
  $("chips").querySelectorAll("button").forEach(b=>b.classList.toggle("on", b.dataset.k===current));
  $("place").classList.toggle("hide", n===2);
  $("save").classList.toggle("hide", n!==2);
  $("undo").classList.toggle("hide", n===0);
  const what = current==="other" ? "this measurement" : LABEL[current].toLowerCase();
  $("save").textContent = current==="other" ? "Save measurement" : "Save as " + what;
  $("prompt").textContent =
    n===0 ? `Aim at the first point for ${what}, then tap Place point.` :
    n===1 ? "Move to the second point and tap Place point." :
            "Happy with it? Save, or redo.";
}

function placePoint(){
  if(!reticle.visible){ $("prompt").textContent="No surface found yet. Move the phone slowly over the floor or wall."; return; }
  const v = reticlePos();
  pts.push(v); addMarker(v);
  if(pts.length===2){ setLine(pts[0],pts[1]); showDist(pts[0].distanceTo(pts[1])); }
  uiState();
}
function saveMeasurement(){
  if(pts.length!==2) return;
  const cm = pts[0].distanceTo(pts[1])*100;
  if(current==="other"){
    const name = "Measurement " + (S.others.length+1);
    S.others.push({id:newId(), name, cm});
    persist(); renderOthers();
    clearPoints(); uiState();
    $("prompt").textContent = `Saved as “${name}”. You can rename it on the page afterwards. Aim at the next thing to measure.`;
    return;
  }
  S.dims[current] = cm; persist(); renderFields(); renderResults();
  const next = KEYS[(KEYS.indexOf(current)+1)%3];
  current = next; clearPoints(); uiState();
}
function undoPoint(){ clearPoints(); uiState(); }

async function startAR(){
  try{
    if(!renderer) initThree();
    session = await navigator.xr.requestSession("immersive-ar", {
      requiredFeatures:["hit-test"],
      optionalFeatures:["dom-overlay"],
      domOverlay:{root:$("arui")}
    });
    renderer.xr.setReferenceSpaceType("local");
    await renderer.xr.setSession(session);
    const viewer = await session.requestReferenceSpace("viewer");
    hitSource = await session.requestHitTestSource({space:viewer});
    session.addEventListener("end", onEnd);
    document.body.classList.add("ar");
    clearPoints(); uiState();
  }catch(err){
    $("arStatus").textContent = "Could not start camera measuring: " + err.message;
  }
}
function onEnd(){
  session=null; hitSource=null; clearPoints();
  document.body.classList.remove("ar");
}

$("arui").addEventListener("beforexrselect", e=>e.preventDefault());
$("place").addEventListener("click", placePoint);
$("save").addEventListener("click", saveMeasurement);
$("undo").addEventListener("click", undoPoint);
$("exit").addEventListener("click", ()=>{ if(session) session.end(); });
$("chips").querySelectorAll("button").forEach(b=>b.addEventListener("click",()=>{
  current=b.dataset.k; clearPoints(); uiState();
}));
$("startAR").addEventListener("click", startAR);

(async function checkSupport(){
  const st = $("arStatus"), btn = $("startAR");
  if(!window.isSecureContext){
    st.textContent = "Camera measuring needs this page served over https. Host it (see instructions), or type the measurements below.";
    return;
  }
  if(!navigator.xr){
    st.textContent = "Camera measuring isn’t available in this browser. Open it in Chrome on Android, or type the measurements below.";
    return;
  }
  try{
    const ok = await navigator.xr.isSessionSupported("immersive-ar");
    if(ok){ btn.disabled=false; st.textContent="Ready. Works best in good light on a floor or wall with some texture."; }
    else st.textContent = "This phone doesn’t support AR measuring (needs Google Play Services for AR). Type the measurements below.";
  }catch(e){ st.textContent = "Couldn’t check AR support. Type the measurements below."; }
})();

renderFields(); renderResults();
</script>
</body>
</html>
